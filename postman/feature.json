									"pm.expect(jsonData).to.be.an('array');",
									"pm.expect(jsonData.length).to.be.greaterThan(0);",
									"const comment = jsonData[0];",
									"pm.expect(comment.id).to.equal(parseInt(pm.environment.get('testCommentId')));",
									"pm.expect(comment.authorId).to.equal(parseInt(pm.environment.get('testUserId')));"
