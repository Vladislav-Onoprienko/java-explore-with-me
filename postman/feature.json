							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Комментарий создан (201)', () => pm.response.to.have.status(201));",
									"const jsonData = pm.response.json();",
									"pm.expect(jsonData).to.have.property('id');",
									"pm.expect(jsonData.text).to.equal(pm.environment.get('testCommentText'));",
									"pm.expect(jsonData.authorId).to.equal(parseInt(pm.environment.get('testUserId')));",
									"pm.expect(jsonData.eventId).to.equal(parseInt(pm.environment.get('testEventId')));",
									"pm.expect(jsonData.status).to.equal('PENDING');",
									"pm.environment.set('testCommentId', jsonData.id);"
								],
